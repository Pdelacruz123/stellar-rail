# Copiar a .env y rellenar. El .env NUNCA se sube: esta en .gitignore.
# Copiar, no renombrar: este archivo tiene que quedarse en el repositorio.
# Requiere Node 22.12 o superior (lo exige @stellar/stellar-sdk 17).

# ---------------------------------------------------------------------------
# Publicas. Vite las incrusta en el codigo que llega al navegador.
# Aqui solo va informacion que puede ser publica.
# ---------------------------------------------------------------------------
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_ASSET_CODE=ALIM
VITE_ISSUER_PUBLIC=

# ---------------------------------------------------------------------------
# Solo servidor. NUNCA con prefijo VITE_: Vite lo publicaria en el navegador.
# Se cargan en el panel de variables de Vercel, nunca en el repositorio.
# ---------------------------------------------------------------------------
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Clave secreta del emisor (empieza con S). Firma autorizar, emitir,
# congelar y anular.
ISSUER_SECRET=

# De aqui se derivan las claves de todas las cuentas de demo, con
# HMAC(MASTER_SEED, "<sesion>:<rol>:<id>"). Asi la base de datos no guarda
# ninguna clave secreta y cada visitante puede tener sus propias cuentas.
# Generar con:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Si se pierde o cambia, las cuentas derivadas quedan inaccesibles.
MASTER_SEED=

# Contrasena del panel del emisor. La URL es publica: sin esto cualquiera
# podria aprobar beneficiarios o vencer programas. Va en el README para que
# el jurado pueda entrar; es testnet y no protege nada de valor.
ADMIN_PASSWORD=

# Postgres en Neon. Guarda programas, beneficiarios, comercios y eventos.
# Nunca saldos: esos viven en Stellar.
DATABASE_URL=
